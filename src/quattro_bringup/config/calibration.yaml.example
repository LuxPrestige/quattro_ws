# Copy this file to calibration.yaml before hardware calibration.
# Offsets are radians. Directions preserve the lgh_ws-old GIM calibration order.
position_control:
  current_limit: 5.0
  position_gain: 20.0
  velocity_gain: 0.16
  velocity_integrator_gain: 0.32

joints:
  front_left_hip_joint: {can_interface: can0, can_id: 0, direction: -1, offset: 0.0}
  front_left_upper_leg_joint: {can_interface: can0, can_id: 1, direction: -1, offset: 0.0}
  front_left_lower_leg_joint: {can_interface: can0, can_id: 2, direction: -1, offset: 0.0}
  front_right_hip_joint: {can_interface: can0, can_id: 3, direction: -1, offset: 0.0}
  front_right_upper_leg_joint: {can_interface: can0, can_id: 4, direction: 1, offset: 0.0}
  front_right_lower_leg_joint: {can_interface: can0, can_id: 5, direction: 1, offset: 0.0}
  back_left_hip_joint: {can_interface: can1, can_id: 6, direction: 1, offset: 0.0}
  back_left_upper_leg_joint: {can_interface: can1, can_id: 7, direction: -1, offset: 0.0}
  back_left_lower_leg_joint: {can_interface: can1, can_id: 8, direction: -1, offset: 0.0}
  back_right_hip_joint: {can_interface: can1, can_id: 9, direction: 1, offset: 0.0}
  back_right_upper_leg_joint: {can_interface: can1, can_id: 10, direction: 1, offset: 0.0}
  back_right_lower_leg_joint: {can_interface: can1, can_id: 11, direction: 1, offset: 0.0}
