<?xml version="1.0"?>
<robot name="quattro">
  <!-- Body Frame -->
  <link name="base_link">
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.43 0.14 0.10" />
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0.001210 -0.000887 -0.007933" />
