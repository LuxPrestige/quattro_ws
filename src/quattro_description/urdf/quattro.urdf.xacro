    <dynamics damping="0.0" friction="0.188"/>
  </joint>

  <link name="back_right_lower_leg_link">
    <xacro:stl_visual filename="right_lower_leg.stl" material_name="black"/>
    <xacro:cylinder_collision xyz="0 0 -0.105" rpy="0 0 0" radius="0.018" length="0.18"/>
    <inertial>
      <origin xyz="0.000176 0 -0.034133" rpy="0 0 0"/>
      <mass value="0.17"/>
      <inertia
        ixx="0.000604957"
        ixy="8e-09"
        ixz="-2.77e-07"
        iyy="0.000622383"
        iyz="-1.3e-08"
        izz="2.5776e-05"/>
    </inertial>
  </link>

  <joint name="back_right_lower_leg_joint" type="revolute">
    <origin xyz="0 0 -0.21" rpy="0 0 0"/>
    <parent link="back_right_upper_leg_link"/>
    <child link="back_right_lower_leg_link"/>
    <axis xyz="0 1 0"/>
    <!-- lower joint limit: -135~135 deg | effort: stall torque 11N·m, velocity: rated speed 120rpm = 12.5663706144 rad/s (motor: 6010-8) -->
    <limit lower="-2.3561944902" upper="2.3561944902" effort="11.0" velocity="12.5663706144"/>
    <!-- friction: no-load current 0.4A x torque constant 0.47N·m/A = 0.188N·m (Coulomb friction estimate); damping: not given in datasheet, kept at 0.0 -->
    <dynamics damping="0.0" friction="0.188"/>
  </joint>

  <link name="back_right_foot_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.025"/></geometry>
      <xacro:if value="$(arg visual_color_override)">
        <material name="visual_color_override"/>
      </xacro:if>
      <xacro:unless value="$(arg visual_color_override)">
        <material name="grey"/>
      </xacro:unless>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.025"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.00005" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.00005"/>
    </inertial>
  </link>

  <joint name="back_right_foot_joint" type="fixed">
    <origin xyz="0 0 -0.21" rpy="0 0 0"/>
    <parent link="back_right_lower_leg_link"/>
    <child link="back_right_foot_link"/>
  </joint>

  <xacro:unless value="$(arg simulation)">
    <ros2_control name="QuattroSystem" type="system">
      <hardware>
        <plugin>quattro_hardware/QuattroSystem</plugin>
        <param name="current_limit">${position_control['current_limit']}</param>
        <param name="position_gain">${position_control['position_gain']}</param>
        <param name="velocity_gain">${position_control['velocity_gain']}</param>
        <param name="velocity_integrator_gain">${position_control['velocity_integrator_gain']}</param>
        <param name="feedback_timeout_ms">150</param>
        <param name="heartbeat_timeout_ms">400</param>
        <param name="startup_timeout_ms">1000</param>
        <!--
          Activation is judged from reported motor state, not from a fixed
          delay. closed_loop_timeout_ms budgets the Heartbeat that confirms
          Set_Axis_State took effect (Heartbeat broadcasts at ~100 ms, so
          this tolerates several missed frames); encoder_sync_timeout_ms
          budgets the EncoderEstimates that follow it (~10 ms each).

          encoder_sync_frames is 2 rather than 1 deliberately. Heartbeat and
          Get_Encoder_Estimates are independent broadcast streams, so the
          first 0x009 seen after a closed-loop Heartbeat may have been
          sampled by the motor before the transition the Heartbeat reports:
          the Heartbeat itself can be up to one period old when it arrives.
          Requiring two frames guarantees at least one estimate
          sampled strictly after closed-loop control was already in effect,
          which is exactly the condition that makes the position
          trustworthy. It costs ~10 ms per joint. A larger value only adds
          margin for hardware that skews these two streams by more than one
          frame period, which has not been observed.
        -->
        <param name="closed_loop_timeout_ms">500</param>
        <param name="encoder_sync_timeout_ms">200</param>
        <param name="encoder_sync_frames">2</param>
        <param name="command_timeout_ms">250</param>
        <param name="scheduling_warning_ms">50</param>
        <param name="rotor_velocity_limit_rev_s">10.0</param>
        <param name="telemetry_period_ms">500</param>
      </hardware>
      <xacro:quattro_hardware_joint name="front_left_hip_joint" lower="-1.04" upper="1.04"/>
      <xacro:quattro_hardware_joint name="front_left_upper_leg_joint" lower="-1.57079632679" upper="2.59"/>
      <xacro:quattro_hardware_joint name="front_left_lower_leg_joint" lower="-2.9" upper="1.57079632679"/>
      <xacro:quattro_hardware_joint name="front_right_hip_joint" lower="-1.04" upper="1.04"/>
      <xacro:quattro_hardware_joint name="front_right_upper_leg_joint" lower="-1.57079632679" upper="2.59"/>
      <xacro:quattro_hardware_joint name="front_right_lower_leg_joint" lower="-2.9" upper="1.57079632679"/>
      <xacro:quattro_hardware_joint name="back_left_hip_joint" lower="-1.04" upper="1.04"/>
      <xacro:quattro_hardware_joint name="back_left_upper_leg_joint" lower="-1.57079632679" upper="2.59"/>
      <xacro:quattro_hardware_joint name="back_left_lower_leg_joint" lower="-2.9" upper="1.57079632679"/>
      <xacro:quattro_hardware_joint name="back_right_hip_joint" lower="-1.04" upper="1.04"/>
      <xacro:quattro_hardware_joint name="back_right_upper_leg_joint" lower="-1.57079632679" upper="2.59"/>
      <xacro:quattro_hardware_joint name="back_right_lower_leg_joint" lower="-2.9" upper="1.57079632679"/>
    </ros2_control>
  </xacro:unless>

  <xacro:if value="$(arg simulation)">
    <ros2_control name="GazeboSimSystem" type="system">
      <hardware>
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </hardware>
      <xacro:quattro_simulation_joint name="front_left_hip_joint" lower="-1.04" upper="1.04" initial_value="0.0"/>
      <xacro:quattro_simulation_joint name="front_left_upper_leg_joint" lower="-1.57079632679" upper="2.59" initial_value="0.63356747785"/>
      <xacro:quattro_simulation_joint name="front_left_lower_leg_joint" lower="-2.9" upper="1.57079632679" initial_value="-1.53223802029"/>
      <xacro:quattro_simulation_joint name="front_right_hip_joint" lower="-1.04" upper="1.04" initial_value="0.0"/>
      <xacro:quattro_simulation_joint name="front_right_upper_leg_joint" lower="-1.57079632679" upper="2.59" initial_value="0.63356747785"/>
      <xacro:quattro_simulation_joint name="front_right_lower_leg_joint" lower="-2.9" upper="1.57079632679" initial_value="-1.53223802029"/>
      <xacro:quattro_simulation_joint name="back_left_hip_joint" lower="-1.04" upper="1.04" initial_value="0.0"/>
      <xacro:quattro_simulation_joint name="back_left_upper_leg_joint" lower="-1.57079632679" upper="2.59" initial_value="0.63356747785"/>
      <xacro:quattro_simulation_joint name="back_left_lower_leg_joint" lower="-2.9" upper="1.57079632679" initial_value="-1.53223802029"/>
      <xacro:quattro_simulation_joint name="back_right_hip_joint" lower="-1.04" upper="1.04" initial_value="0.0"/>
      <xacro:quattro_simulation_joint name="back_right_upper_leg_joint" lower="-1.57079632679" upper="2.59" initial_value="0.63356747785"/>
      <xacro:quattro_simulation_joint name="back_right_lower_leg_joint" lower="-2.9" upper="1.57079632679" initial_value="-1.53223802029"/>
    </ros2_control>

    <gazebo>
      <plugin
        filename="libgz_ros2_control-system.so"
        name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(arg simulation_controllers)</parameters>
      </plugin>
    </gazebo>
  </xacro:if>

</robot>
