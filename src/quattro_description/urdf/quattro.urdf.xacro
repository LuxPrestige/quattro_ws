  <joint name="back_right_foot_joint" type="fixed">
    <origin xyz="0 0 -0.21" rpy="0 0 0"/>
    <parent link="back_right_lower_leg_link"/>
    <child link="back_right_foot_link"/>
  </joint>

  <ros2_control name="QuattroSystem" type="system">
    <hardware>
      <plugin>quattro_hardware/QuattroSystem</plugin>
      <param name="feedback_timeout_ms">100</param>
      <param name="startup_timeout_ms">1000</param>
      <param name="command_timeout_ms">100</param>
      <param name="motor_velocity_limit">50.0</param>
      <param name="motor_current_limit">20.0</param>
    </hardware>
    <xacro:quattro_hardware_joint name="front_left_hip_joint" lower="-1.04" upper="1.04"/>
    <xacro:quattro_hardware_joint name="front_left_upper_leg_joint" lower="-1.57079632679" upper="2.59"/>
    <xacro:quattro_hardware_joint name="front_left_lower_leg_joint" lower="-2.9" upper="1.57079632679"/>
    <xacro:quattro_hardware_joint name="front_right_hip_joint" lower="-1.04" upper="1.04"/>
    <xacro:quattro_hardware_joint name="front_right_upper_leg_joint" lower="-1.57079632679" upper="2.59"/>
    <xacro:quattro_hardware_joint name="front_right_lower_leg_joint" lower="-2.9" upper="1.57079632679"/>
    <xacro:quattro_hardware_joint name="back_left_hip_joint" lower="-1.04" upper="1.04"/>
    <xacro:quattro_hardware_joint name="back_left_upper_leg_joint" lower="-1.57079632679" upper="2.59"/>
    <xacro:quattro_hardware_joint name="back_left_lower_leg_joint" lower="-2.9" upper="1.57079632679"/>
    <xacro:quattro_hardware_joint name="back_right_hip_joint" lower="-1.04" upper="1.04"/>
    <xacro:quattro_hardware_joint name="back_right_upper_leg_joint" lower="-1.57079632679" upper="2.59"/>
    <xacro:quattro_hardware_joint name="back_right_lower_leg_joint" lower="-2.9" upper="1.57079632679"/>
  </ros2_control>

</robot>
