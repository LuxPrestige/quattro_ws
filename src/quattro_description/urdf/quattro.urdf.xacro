<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="quattro">

  <xacro:arg
    name="calibration_file"
    default="../config/calibration.yaml"/>
  <xacro:arg name="simulation" default="false"/>
  <xacro:arg name="visual_color_override" default="false"/>
  <xacro:arg name="visual_color" default="0.1 0.1 0.1 1.0"/>
  <xacro:arg
    name="simulation_controllers"
    default="../../quattro_gazebo/config/gazebo_controllers.yaml"/>
  <xacro:property name="calibration" value="${xacro.load_yaml('$(arg calibration_file)')}"/>
  <xacro:property name="hardware_calibration" value="${calibration['joints']}"/>
  <xacro:property name="position_control" value="${calibration['position_control']}"/>

  <!--
    Mesh directory:
      package://quattro_description/meshes/stl/

    STL files are used for visual geometry only. Collision geometry uses primitives.
    The original URDF used scale="1 1 1", so that value is preserved.
    Change mesh_scale to "0.001 0.001 0.001" only when the STL is exported in millimetres.
  -->
  <xacro:property name="mesh_prefix" value="package://quattro_description/meshes/stl"/>
  <xacro:property name="mesh_scale" value="1 1 1"/>

  <material name="orange">
    <color rgba="1.0 0.5 0.0 1.0"/>
  </material>
  <material name="black">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>
  <material name="grey">
    <color rgba="0.6 0.6 0.6 1.0"/>
  </material>
  <material name="visual_color_override">
    <color rgba="$(arg visual_color)"/>
  </material>

  <xacro:macro name="stl_visual" params="filename material_name">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="${mesh_prefix}/${filename}" scale="${mesh_scale}"/>
      </geometry>
      <xacro:if value="$(arg visual_color_override)">
        <material name="visual_color_override"/>
      </xacro:if>
      <xacro:unless value="$(arg visual_color_override)">
        <material name="${material_name}"/>
      </xacro:unless>
    </visual>
  </xacro:macro>

  <xacro:macro name="box_collision" params="xyz rpy size">
    <collision>
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <geometry>
        <box size="${size}"/>
      </geometry>
    </collision>
  </xacro:macro>

  <xacro:macro name="cylinder_collision" params="xyz rpy radius length">
    <collision>
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <geometry>
        <cylinder radius="${radius}" length="${length}"/>
      </geometry>
    </collision>
  </xacro:macro>

  <xacro:macro name="sphere_collision" params="xyz radius">
    <collision>
      <origin xyz="${xyz}" rpy="0 0 0"/>
      <geometry>
        <sphere radius="${radius}"/>
      </geometry>
    </collision>
  </xacro:macro>

  <xacro:macro name="quattro_hardware_joint" params="name lower upper">
    <joint name="${name}">
      <command_interface name="position">
        <param name="min">${lower}</param>
        <param name="max">${upper}</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <param name="can_interface">${hardware_calibration[name]['can_interface']}</param>
      <param name="can_id">${hardware_calibration[name]['can_id']}</param>
      <param name="direction">${hardware_calibration[name]['direction']}</param>
      <param name="offset">${hardware_calibration[name]['offset']}</param>
      <param name="gear_ratio">8.0</param>
    </joint>
  </xacro:macro>

  <xacro:macro name="quattro_simulation_joint" params="name lower upper initial_value">
    <joint name="${name}">
      <command_interface name="position">
        <param name="min">${lower}</param>
        <param name="max">${upper}</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">${initial_value}</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </xacro:macro>

  <!-- ================================================================ -->
  <!-- Base                                                             -->
  <!-- ================================================================ -->
  <link name="base_link">
    <xacro:stl_visual filename="body_frame.stl" material_name="orange"/>
    <xacro:box_collision xyz="0 0 0" rpy="0 0 0" size="0.30 0.24 0.10"/>
    <inertial>
      <origin xyz="0.001210 -0.000887 -0.007933" rpy="0 0 0"/>
      <mass value="3.092"/>
      <inertia
        ixx="0.012720949"
        ixy="0.000098785"
        ixz="-0.000130401"
        iyy="0.034500612"
        iyz="0.000097314"
        izz="0.043632308"/>
    </inertial>
  </link>

  <!-- ================================================================ -->
  <!-- Front-left leg                                                   -->
  <!-- ================================================================ -->
  <link name="front_left_hip_link">
    <xacro:stl_visual filename="front_left_hip.stl" material_name="black"/>
    <xacro:cylinder_collision xyz="0 0.02 0" rpy="1.57079632679 0 0" radius="0.035" length="0.075"/>
    <inertial>
      <origin xyz="-0.003 -0.000913 -0.000423" rpy="0 0 0"/>
      <mass value="0.421"/>
      <inertia
        ixx="0.000208442"
        ixy="-9.7e-07"
        ixz="3.59e-06"
        iyy="0.00034713"
        iyz="-2.271e-06"
        izz="0.000242004"/>
    </inertial>
  </link>

  <joint name="front_left_hip_joint" type="revolute">
    <origin xyz="0.2025 0.06 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="front_left_hip_link"/>
    <axis xyz="1 0 0"/>
    <!-- hip joint limit: -45~45 deg | effort: stall torque 11N·m, velocity: rated speed 120rpm = 12.5663706144 rad/s (motor: 6010-8) -->
    <limit lower="-0.7853981634" upper="0.7853981634" effort="11.0" velocity="12.5663706144"/>
    <!-- friction: no-load current 0.4A x torque constant 0.47N·m/A = 0.188N·m (Coulomb friction estimate); damping: not given in datasheet, kept at 0.0 -->
    <dynamics damping="0.0" friction="0.188"/>
  </joint>

  <link name="front_left_upper_leg_link">
    <xacro:stl_visual filename="left_upper_leg.stl" material_name="black"/>
    <xacro:box_collision xyz="0 0 -0.090" rpy="0 0 0" size="0.045 0.045 0.18"/>
    <inertial>
      <origin xyz="0.00011 -0.017289 -0.042003" rpy="0 0 0"/>
      <mass value="0.823"/>
      <inertia
        ixx="0.004380506"
        ixy="1.19e-06"
        ixz="-3.916e-06"
        iyy="0.004394642"
        iyz="0.000544858"
        izz="0.000779349"/>
    </inertial>
  </link>

  <joint name="front_left_upper_leg_joint" type="revolute">
    <origin xyz="0 0.0905 0" rpy="0 0 0"/>
    <parent link="front_left_hip_link"/>
    <child link="front_left_upper_leg_link"/>
    <axis xyz="0 1 0"/>
    <!-- upper joint limit: -90~140 deg | effort: stall torque 11N·m, velocity: rated speed 120rpm = 12.5663706144 rad/s (motor: 6010-8) -->
    <limit lower="-1.5707963268" upper="2.4434609528" effort="11.0" velocity="12.5663706144"/>
    <!-- friction: no-load current 0.4A x torque constant 0.47N·m/A = 0.188N·m (Coulomb friction estimate); damping: not given in datasheet, kept at 0.0 -->
    <dynamics damping="0.0" friction="0.188"/>
  </joint>

  <link name="front_left_lower_leg_link">
    <xacro:stl_visual filename="left_lower_leg.stl" material_name="black"/>
    <xacro:cylinder_collision xyz="0 0 -0.090" rpy="0 0 0" radius="0.018" length="0.18"/>
    <inertial>
      <origin xyz="-0.000176 0 -0.034133" rpy="0 0 0"/>
      <mass value="0.17"/>
      <inertia
        ixx="0.000604957"
        ixy="8e-09"
        ixz="2.77e-07"
        iyy="0.000622383"
        iyz="1.3e-08"
        izz="2.5776e-05"/>
    </inertial>
  </link>

  <joint name="front_left_lower_leg_joint" type="revolute">
    <origin xyz="0 0 -0.21" rpy="0 0 0"/>
    <parent link="front_left_upper_leg_link"/>
    <child link="front_left_lower_leg_link"/>
    <axis xyz="0 1 0"/>
    <!-- lower joint limit: -135~135 deg | effort: stall torque 11N·m, velocity: rated speed 120rpm = 12.5663706144 rad/s (motor: 6010-8) -->
    <limit lower="-2.3561944902" upper="2.3561944902" effort="11.0" velocity="12.5663706144"/>
    <!-- friction: no-load current 0.4A x torque constant 0.47N·m/A = 0.188N·m (Coulomb friction estimate); damping: not given in datasheet, kept at 0.0 -->
    <dynamics damping="0.0" friction="0.188"/>
  </joint>

  <link name="front_left_foot_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.025"/></geometry>
      <xacro:if value="$(arg visual_color_override)">
        <material name="visual_color_override"/>
      </xacro:if>
      <xacro:unless value="$(arg visual_color_override)">
        <material name="grey"/>
      </xacro:unless>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.025"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.00005" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.00005"/>
    </inertial>
  </link>

  <joint name="front_left_foot_joint" type="fixed">
    <origin xyz="0 0 -0.21" rpy="0 0 0"/>
    <parent link="front_left_lower_leg_link"/>
    <child link="front_left_foot_link"/>
  </joint>

