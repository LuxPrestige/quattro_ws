<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="quattro">

  <xacro:arg
    name="calibration_file"
    default="../config/calibration.yaml"/>
  <xacro:property
    name="hardware_calibration"
    value="${xacro.load_yaml('$(arg calibration_file)')['joints']}"/>

  <!--
    Mesh directory:
      package://quattro_description/meshes/stl/

    The same STL is used for both visual and collision geometry.
    The original URDF used scale="1 1 1", so that value is preserved.
    Change mesh_scale to "0.001 0.001 0.001" only when the STL is exported in millimetres.
  -->
  <xacro:property name="mesh_prefix" value="package://quattro_description/meshes/stl"/>
  <xacro:property name="mesh_scale" value="1 1 1"/>

  <material name="orange">
    <color rgba="1.0 0.5 0.0 1.0"/>
  </material>
  <material name="black">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>
  <material name="grey">
    <color rgba="0.6 0.6 0.6 1.0"/>
  </material>

  <!-- Creates visual and collision elements from the same STL file. -->
  <xacro:macro name="stl_visual_collision" params="filename material_name">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="${mesh_prefix}/${filename}" scale="${mesh_scale}"/>
      </geometry>
      <material name="${material_name}"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="${mesh_prefix}/${filename}" scale="${mesh_scale}"/>
      </geometry>
    </collision>
  </xacro:macro>

  <xacro:macro name="quattro_hardware_joint" params="name lower upper">
    <joint name="${name}">
      <command_interface name="position">
        <param name="min">${lower}</param>
        <param name="max">${upper}</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <param name="can_interface">${hardware_calibration[name]['can_interface']}</param>
      <param name="can_id">${hardware_calibration[name]['can_id']}</param>
      <param name="direction">${hardware_calibration[name]['direction']}</param>
      <param name="offset">${hardware_calibration[name]['offset']}</param>
      <param name="kp">${hardware_calibration[name]['kp']}</param>
      <param name="kd">${hardware_calibration[name]['kd']}</param>
    </joint>
  </xacro:macro>

  <!-- ================================================================ -->
  <!-- Base                                                             -->
  <!-- ================================================================ -->
  <link name="base_link">
    <xacro:stl_visual_collision filename="body_frame.stl" material_name="orange"/>
    <inertial>
      <origin xyz="0.001210 -0.000887 -0.007933" rpy="0 0 0"/>
      <mass value="3.092"/>
      <inertia
        ixx="0.012720949"
        ixy="0.000098785"
        ixz="-0.000130401"
        iyy="0.034500612"
        iyz="0.000097314"
        izz="0.043632308"/>
    </inertial>
  </link>

  <!-- ================================================================ -->
  <!-- Front-left leg                                                   -->
  <!-- ================================================================ -->
  <link name="front_left_hip_link">
    <xacro:stl_visual_collision filename="front_left_hip.stl" material_name="black"/>
    <inertial>
      <origin xyz="-0.003 -0.000913 -0.000423" rpy="0 0 0"/>
      <mass value="0.421"/>
      <inertia
        ixx="0.000208442"
        ixy="-9.7e-07"
        ixz="3.59e-06"
        iyy="0.00034713"
        iyz="-2.271e-06"
        izz="0.000242004"/>
    </inertial>
  </link>

  <joint name="front_left_hip_joint" type="revolute">
    <origin xyz="0.2025 0.06 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="front_left_hip_link"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.04" upper="1.04" effort="40.0" velocity="4.0"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>

  <link name="front_left_upper_leg_link">
    <xacro:stl_visual_collision filename="left_upper_leg.stl" material_name="black"/>
    <inertial>
      <origin xyz="0.00011 -0.017289 -0.042003" rpy="0 0 0"/>
      <mass value="0.823"/>
      <inertia
        ixx="0.004380506"
        ixy="1.19e-06"
        ixz="-3.916e-06"
        iyy="0.004394642"
        iyz="0.000544858"
        izz="0.000779349"/>
    </inertial>
  </link>

  <joint name="front_left_upper_leg_joint" type="revolute">
    <origin xyz="0 0.0905 0" rpy="0 0 0"/>
    <parent link="front_left_hip_link"/>
    <child link="front_left_upper_leg_link"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57079632679" upper="2.59" effort="40.0" velocity="4.0"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>

  <link name="front_left_lower_leg_link">
    <xacro:stl_visual_collision filename="left_lower_leg.stl" material_name="black"/>
    <inertial>
      <origin xyz="-0.000176 0 -0.034133" rpy="0 0 0"/>
      <mass value="0.17"/>
      <inertia
        ixx="0.000604957"
        ixy="8e-09"
        ixz="2.77e-07"
        iyy="0.000622383"
        iyz="1.3e-08"
        izz="2.5776e-05"/>
    </inertial>
  </link>

  <joint name="front_left_lower_leg_joint" type="revolute">
    <origin xyz="0 0 -0.21" rpy="0 0 0"/>
    <parent link="front_left_upper_leg_link"/>
    <child link="front_left_lower_leg_link"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.9" upper="1.57079632679" effort="40.0" velocity="4.0"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>

  <link name="front_left_foot_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.025"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.025"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.00005" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.00005"/>
    </inertial>
  </link>

  <joint name="front_left_foot_joint" type="fixed">
    <origin xyz="0 0 -0.21" rpy="0 0 0"/>
    <parent link="front_left_lower_leg_link"/>
    <child link="front_left_foot_link"/>
  </joint>

  <!-- ================================================================ -->
  <!-- Front-right leg                                                  -->
  <!-- ================================================================ -->
  <link name="front_right_hip_link">
    <xacro:stl_visual_collision filename="front_right_hip.stl" material_name="black"/>
    <inertial>
      <origin xyz="-0.003304 0.000913 -0.000118" rpy="0 0 0"/>
      <mass value="0.421"/>
      <inertia
        ixx="0.000208731"
        ixy="1.164e-06"
        ixz="3.22e-06"
        iyy="0.000346391"
        iyz="2.078e-06"
        izz="0.000240976"/>
    </inertial>
  </link>

  <joint name="front_right_hip_joint" type="revolute">
    <origin xyz="0.2025 -0.06 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="front_right_hip_link"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.04" upper="1.04" effort="40.0" velocity="4.0"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>

  <link name="front_right_upper_leg_link">
    <xacro:stl_visual_collision filename="right_upper_leg.stl" material_name="black"/>
    <inertial>
      <origin xyz="-0.00011 0.017289 -0.042003" rpy="0 0 0"/>
      <mass value="0.823"/>
      <inertia
        ixx="0.004380506"
        ixy="1.19e-06"
        ixz="3.916e-06"
        iyy="0.004394642"
        iyz="-0.000544858"
        izz="0.000779349"/>
    </inertial>
  </link>

  <joint name="front_right_upper_leg_joint" type="revolute">
    <origin xyz="0 -0.0905 0" rpy="0 0 0"/>
    <parent link="front_right_hip_link"/>
    <child link="front_right_upper_leg_link"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57079632679" upper="2.59" effort="40.0" velocity="4.0"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>

  <link name="front_right_lower_leg_link">
    <xacro:stl_visual_collision filename="right_lower_leg.stl" material_name="black"/>
    <inertial>
      <origin xyz="0.000176 0 -0.034133" rpy="0 0 0"/>
      <mass value="0.17"/>
      <inertia
        ixx="0.000604957"
        ixy="8e-09"
        ixz="-2.77e-07"
        iyy="0.000622383"
        iyz="-1.3e-08"
        izz="2.5776e-05"/>
    </inertial>
  </link>

  <joint name="front_right_lower_leg_joint" type="revolute">
    <origin xyz="0 0 -0.21" rpy="0 0 0"/>
    <parent link="front_right_upper_leg_link"/>
    <child link="front_right_lower_leg_link"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.9" upper="1.57079632679" effort="40.0" velocity="4.0"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>

  <link name="front_right_foot_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.025"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.025"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.00005" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.00005"/>
    </inertial>
  </link>

  <joint name="front_right_foot_joint" type="fixed">
    <origin xyz="0 0 -0.21" rpy="0 0 0"/>
    <parent link="front_right_lower_leg_link"/>
    <child link="front_right_foot_link"/>
  </joint>

  <!-- ================================================================ -->
  <!-- Back-left leg                                                    -->
  <!-- ================================================================ -->
  <link name="back_left_hip_link">
    <xacro:stl_visual_collision filename="back_left_hip.stl" material_name="black"/>
    <inertial>
      <origin xyz="0.003304 -0.000713 -0.000118" rpy="0 0 0"/>
      <mass value="0.421"/>
      <inertia
        ixx="0.000208731"
        ixy="1.164e-06"
        ixz="-3.22e-06"
        iyy="0.000346392"
        iyz="-2.078e-06"
        izz="0.000240976"/>
    </inertial>
  </link>

  <joint name="back_left_hip_joint" type="revolute">
    <origin xyz="-0.2025 0.06 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="back_left_hip_link"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.04" upper="1.04" effort="40.0" velocity="4.0"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>

  <link name="back_left_upper_leg_link">
    <xacro:stl_visual_collision filename="left_upper_leg.stl" material_name="black"/>
    <inertial>
      <origin xyz="0.00011 -0.017289 -0.042003" rpy="0 0 0"/>
      <mass value="0.823"/>
      <inertia
        ixx="0.004380506"
        ixy="1.19e-06"
        ixz="-3.916e-06"
        iyy="0.004394642"
        iyz="0.000544858"
        izz="0.000779349"/>
    </inertial>
  </link>

  <joint name="back_left_upper_leg_joint" type="revolute">
    <origin xyz="0 0.0905 0" rpy="0 0 0"/>
    <parent link="back_left_hip_link"/>
    <child link="back_left_upper_leg_link"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57079632679" upper="2.59" effort="40.0" velocity="4.0"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>

  <link name="back_left_lower_leg_link">
    <xacro:stl_visual_collision filename="left_lower_leg.stl" material_name="black"/>
    <inertial>
      <origin xyz="-0.000176 0 -0.034133" rpy="0 0 0"/>
      <mass value="0.17"/>
      <inertia
        ixx="0.000604957"
        ixy="8e-09"
        ixz="2.77e-07"
        iyy="0.000622383"
        iyz="1.3e-08"
        izz="2.5776e-05"/>
    </inertial>
  </link>

  <joint name="back_left_lower_leg_joint" type="revolute">
    <origin xyz="0 0 -0.21" rpy="0 0 0"/>
    <parent link="back_left_upper_leg_link"/>
    <child link="back_left_lower_leg_link"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.9" upper="1.57079632679" effort="40.0" velocity="4.0"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>

  <link name="back_left_foot_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.025"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.025"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.00005" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.00005"/>
    </inertial>
  </link>

  <joint name="back_left_foot_joint" type="fixed">
    <origin xyz="0 0 -0.21" rpy="0 0 0"/>
    <parent link="back_left_lower_leg_link"/>
    <child link="back_left_foot_link"/>
  </joint>

  <!-- ================================================================ -->
  <!-- Back-right leg                                                   -->
  <!-- ================================================================ -->
  <link name="back_right_hip_link">
    <xacro:stl_visual_collision filename="back_right_hip.stl" material_name="black"/>
    <inertial>
      <origin xyz="0.003 0.001113 -0.000423" rpy="0 0 0"/>
      <mass value="0.421"/>
      <inertia
        ixx="0.000208442"
        ixy="-9.7e-07"
        ixz="-3.59e-06"
        iyy="0.00034713"
        iyz="2.271e-06"
        izz="0.000242004"/>
    </inertial>
  </link>

  <joint name="back_right_hip_joint" type="revolute">
    <origin xyz="-0.2025 -0.06 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="back_right_hip_link"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.04" upper="1.04" effort="40.0" velocity="4.0"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>

  <link name="back_right_upper_leg_link">
    <xacro:stl_visual_collision filename="right_upper_leg.stl" material_name="black"/>
    <inertial>
      <origin xyz="-0.00011 0.017289 -0.042003" rpy="0 0 0"/>
      <mass value="0.823"/>
      <inertia
        ixx="0.004380506"
        ixy="1.19e-06"
        ixz="3.916e-06"
        iyy="0.004394642"
        iyz="-0.000544858"
        izz="0.000779349"/>
    </inertial>
  </link>

  <joint name="back_right_upper_leg_joint" type="revolute">
    <origin xyz="0 -0.0905 0" rpy="0 0 0"/>
    <parent link="back_right_hip_link"/>
    <child link="back_right_upper_leg_link"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57079632679" upper="2.59" effort="40.0" velocity="4.0"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>

  <link name="back_right_lower_leg_link">
    <xacro:stl_visual_collision filename="right_lower_leg.stl" material_name="black"/>
    <inertial>
      <origin xyz="0.000176 0 -0.034133" rpy="0 0 0"/>
      <mass value="0.17"/>
      <inertia
        ixx="0.000604957"
        ixy="8e-09"
        ixz="-2.77e-07"
        iyy="0.000622383"
        iyz="-1.3e-08"
        izz="2.5776e-05"/>
    </inertial>
  </link>

  <joint name="back_right_lower_leg_joint" type="revolute">
    <origin xyz="0 0 -0.21" rpy="0 0 0"/>
    <parent link="back_right_upper_leg_link"/>
    <child link="back_right_lower_leg_link"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.9" upper="1.57079632679" effort="40.0" velocity="4.0"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>

  <link name="back_right_foot_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.025"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.025"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.00005" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.00005"/>
